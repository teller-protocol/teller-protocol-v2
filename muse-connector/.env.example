# HTTP listener
PORT=8080

# Upstream pre-qualification API.
# Leave PREQUAL_API_BASE_URL unset to run against the built-in fixture backend
# (no network, no lead ever leaves the process). Set it to switch to the live API.
# PREQUAL_API_BASE_URL=https://api.teller.org/prequal/v1
# PREQUAL_API_KEY=

# Where US borrowers are sent to finish an application.
US_FUNNEL_BASE_URL=https://teller.org/prequalify

# Comma-separated ISO-3166 alpha-2 codes served by this connector.
SUPPORTED_COUNTRIES=US,CA
