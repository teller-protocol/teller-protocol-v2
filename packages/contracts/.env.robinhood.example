# Robinhood Chain (4663) — values to copy into packages/contracts/.env
#
# Everything else for this deployment is wired in code: the Uniswap V3 factory,
# WETH9 and the owner Safe, all verified on chain 4663. What is left is the
# deployer key, funding it, and the timelock address that pass 1 produces.

# --- Required by hardhat itself --------------------------------------------
# Pre-existing requirement, not Robinhood-specific: hardhat will not start
# without it. https://app.safe.global/settings/setup
SAFE_GLOBAL_API_KEY=

# --- RPC -------------------------------------------------------------------
# Public endpoint. Swap in an Alchemy/QuickNode URL for the deploy if the public
# one rate-limits; Alchemy supports Robinhood Chain mainnet.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Safe ------------------------------------------------------------------
# DONE. 0x654Dc22CC48Ca029A0EAD3Bf66e73BF2db71eA28 is hardcoded in
# hardhat.config.ts under namedAccounts.protocolOwnerSafe[4663], the same way
# every other chain's Safe is. Verified on chain 4663: Safe v1.4.1, threshold 2
# of 5 owners. Nothing to set here.

# Safe Transaction Service host. The default guess follows the standard
# *.safe.global pattern; confirm it resolves for 4663 before the first Safe
# proposal. ApeChain needed a third-party host, so this is not guaranteed.
# ROBINHOOD_SAFE_TX_SERVICE=https://safe-transaction-robinhood.safe.global

# --- Timelock --------------------------------------------------------------
# STEP 3: leave empty for deploy pass 1. Afterwards copy the "address" field
# from deployments/robinhood/TimelockController.json in here and run pass 2,
# which completes the ownership transfers to the timelock.
ROBINHOOD_TIMELOCK_ADDRESS=

# --- Uniswap V3 ------------------------------------------------------------
# The factory and WETH9 are now hardcoded in helpers/ecosystem-contracts-lookup.ts,
# read off chain 4663 and confirmed: a live v3 pool reports
# 0x1f7d7550B1b028f7571E69A784071F0205FD2EfA as its factory(), and that address
# answers as a verified UniswapV3Factory. WETH is
# 0x0bd7d308f8e1639fab988df18a8011f41eacad73 (18 decimals). Nothing to set here.
#
# Router and quoter are only read by borrow_swap.ts, which is NOT enabled for
# robinhood. Set these only if you turn BorrowSwap on later.
# ROBINHOOD_UNISWAP_V3_SWAP_ROUTER=
# ROBINHOOD_UNISWAP_V3_QUOTER=

# --- Verification ----------------------------------------------------------
# Defaults to Etherscan V2 multichain, reusing ETHERSCANV2_VERIFY_API_KEY.
# Etherscan V2 coverage for 4663 is unconfirmed — if `yarn contracts verify
# --network robinhood` fails, uncomment these to use Blockscout instead.
# ROBINHOOD_VERIFY_API_URL=https://robinhoodchain.blockscout.com/api
# ROBINHOOD_EXPLORER_URL=https://robinhoodchain.blockscout.com
# ROBINHOOD_VERIFY_API_KEY=abc
